# Базовый URL API GREEN-API.
#
# Типовой дефолт — универсальный хост https://api.green-api.com, он сам
# направляет запросы на кластер нужного инстанса, так что ничего менять
# не обязательно.
#
# Если всё же хотите ходить напрямую в свой кластер, возьмите apiUrl из
# личного кабинета https://console.green-api.com (рядом с idInstance) —
# например https://3100.api.green-api.com, и раскомментируйте строку ниже.
VITE_GREEN_API_URL=https://api.green-api.com
